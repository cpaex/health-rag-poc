# Copy to .env and fill in after `terraform apply` (Phase 1+).
# Values below are placeholders/defaults; empty ones are populated from Terraform outputs.

AWS_REGION=us-east-1
AWS_PROFILE=

# --- Aurora (Phase 1: data_aurora module outputs) ---
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=

# --- Bedrock Knowledge Base (Phase 2: knowledge_base module output) ---
KNOWLEDGE_BASE_ID=

# --- Bedrock Guardrails (Phase 5: guardrails module outputs) ---
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# --- AgentCore Runtime (Phase 6: agentcore module output) ---
AGENTCORE_RUNTIME_ARN=

# --- Agent execution mode ---
AGENT_MODE=local            # local | agentcore

# --- Model IDs (verify against Bedrock model catalog at build time) ---
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0

# --- Mocked FHIR endpoint (non-goal: real HealthLake/Epic) ---
MOCK_FHIR_ENDPOINT_URL=http://localhost:8000
